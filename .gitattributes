# Normalise line endings in the repository so the checkout is identical on
# every platform. Windows clients keep working copies as CRLF via autocrlf.
* text=auto eol=lf

# Genuinely binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
